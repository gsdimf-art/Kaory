local vTrack=setmetatable({},{__mode="k"})
Env.Run.Heartbeat:Connect(function(dt)
	if dt<=0 then return end
	local now=os.clock()
	local win=math.clamp(C.Aim.Win,40,300)/1000
	for _,pl in ipairs(Env.Players:GetPlayers()) do
		local r=pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
		if r then
			local d=vTrack[r]
			if not d then d={s={},vel=Vector3.zero,acc=Vector3.zero,last=r.Position}; vTrack[r]=d end
			if (r.Position-d.last).Magnitude>120 then d.s={} end
			d.last=r.Position
			table.insert(d.s,{t=now,p=r.Position})
			while #d.s>2 and now-d.s[1].t>win do table.remove(d.s,1) end
			local n=#d.s
			if n>=3 then
				local t0=d.s[1].t
				local sx,sy=0,0
				for i=1,n do local x=d.s[i].t-t0; sx=sx+x; sy=sy+x*x end
				local den=n*sy-sx*sx
				if math.abs(den)>1e-9 then
					local num=Vector3.zero
					for i=1,n do local x=d.s[i].t-t0; num=num+(n*x-sx)*d.s[i].p end
					local newVel=num/den
					local a=math.clamp(C.Aim.Smooth,0.05,1)
					d.acc=(newVel-d.vel)/math.max(win,0.02)
					d.vel=d.vel:Lerp(newVel,a)
				end
			elseif n==2 then
				local dd=d.s[2].t-d.s[1].t
				if dd>0 then d.vel=d.vel:Lerp((d.s[2].p-d.s[1].p)/dd,0.5) end
			end
		end
	end
	local ok,v=pcall(function() return Env.Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
	if not ok or not v or v<=0 then
		local o2,p2=pcall(function() return LP:GetNetworkPing() end)
