local function GunPartOf(g)
	if not g then return nil end
	if g:IsA("BasePart") then return g end
	return g.PrimaryPart or g:FindFirstChild("Handle") or g:FindFirstChildWhichIsA("BasePart",true)
end
local function GrabBlocked()
	local c=RealChar(); local b=Back()
	if not c then return true end
	if (c:FindFirstChild("Knife")) or (b and b:FindFirstChild("Knife")) then return true end
	if (c:FindFirstChild("Gun")) or (b and b:FindFirstChild("Gun")) then return true end
	return false
end
local function GrabNow(g)
	if not C.Grab.On then return false end
	g=g or S.GunDrop
	if not g or not g.Parent then return false end
	if GrabBlocked() then return false end
	local gp=GunPartOf(g); if not gp then return false end
	local c=RealChar(); local hrp=c and c:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	if C.Grab.Range>0 and (gp.Position-hrp.Position).Magnitude>C.Grab.Range then return false end
	local t0=os.clock()
	local fti=firetouchinterest
	local mode=C.Grab.Mode
	local limbs=S.GrabLimbs
	if #limbs==0 then CacheLimbs(); limbs=S.GrabLimbs end

	-- МОЛНИЕНОСНЫЙ ЗАХВАТ НА ПРЕДЕЛЕ ДВИЖКА (ГОНКА ВСЕХ МЕТОДОВ)
	if mode==1 or mode==4 then
		pcall(function()
			gp.CanCollide=false
			if g:IsA("Model") then g:PivotTo(hrp.CFrame) else gp.CFrame=hrp.CFrame end
		end)
	end
	if mode==2 or mode==4 then
		if fti then
			for i=1,#limbs do local l=limbs[i]; if l.Parent then pcall(fti,l,gp,0); pcall(fti,l,gp,1) end end
		end
	end
	if mode==3 or mode==4 then
		local sv=hrp.CFrame
		pcall(function()
			hrp.AssemblyLinearVelocity=Vector3.zero; hrp.CFrame=gp.CFrame
			if fti then
				for i=1,#limbs do local l=limbs[i]; if l.Parent then pcall(fti,l,gp,0); pcall(fti,l,gp,1) end end
			end
			hrp.CFrame=sv; hrp.AssemblyLinearVelocity=Vector3.zero
		end)
	end
	S.GrabMS=(os.clock()-t0)*1000
	S.GrabTries=S.GrabTries+1
	if not GrabBlocked() then return false end
	S.GrabDone=true
	if C.Grab.Notify then
		local react=S.GrabSpawnT>0 and ((os.clock()-S.GrabSpawnT)*1000) or 0
		UI.Toast("GunDrop","Auto Grab",string.format("%.1f ms reaction",react),C.GunCol,nil)
	end
	return true
end
local function OnGunSpawn(d)
	if d.Name~="GunDrop" then return end
	S.GunDrop=d; S.GrabSpawnT=os.clock(); S.GrabDone=false; S.GrabTries=0
	if not C.Grab.On then return end
	if C.Grab.Delay>0 then task.wait(C.Grab.Delay) end
	GrabNow(d)
end
