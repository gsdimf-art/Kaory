local function PointVisible(pos,tchar)
	local cam=Cam(); if not cam then return false end
	local _,on=cam:WorldToViewportPoint(pos)
	if not on then return false end
	local rp=RaycastParams.new(); rp.FilterType=Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances=IgnoreList
	local hit=SafeRay(cam.CFrame.Position,pos-cam.CFrame.Position,rp)
	if not hit then return true end
	return tchar and hit.Instance:IsDescendantOf(tchar) or false
end
local function BestAimPoint(part,ch,allowWall)
	local c=part.Position
	if allowWall then return c end
	if PointVisible(c,ch) then return c end
	if not C.Aim.Grid then return nil end
	local sx,sy,sz=part.Size.X*0.32,part.Size.Y*0.32,part.Size.Z*0.32
	local best,bd=nil,math.huge
	for _,o in ipairs({
		Vector3.new(0,sy,0),Vector3.new(0,-sy,0),Vector3.new(sx,0,0),Vector3.new(-sx,0,0),
		Vector3.new(0,0,sz),Vector3.new(0,0,-sz),Vector3.new(sx,sy,0),Vector3.new(-sx,sy,0),
		Vector3.new(0,sy,sz),Vector3.new(0,sy,-sz),
	}) do
		local p=c+o
		if PointVisible(p,ch) then
			local d=o.Magnitude
			if d<bd then bd=d; best=p end
		end
	end
	return best
end
local function BestHitPart(ch,allowWall,prefIdx)
	if not ch then return nil end
	local order={}
	local pref=HITPARTS[math.clamp(prefIdx or 1,1,#HITPARTS)]
	order[1]=pref
	for _,n in ipairs(HITPARTS) do if n~=pref then order[#order+1]=n end end
	local best,bestScore,bestPt=nil,-1,nil
	for rank,name in ipairs(order) do
		local p=ch:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			local pt=BestAimPoint(p,ch,allowWall)
			if pt then
				local score=math.min(p.Size.X*p.Size.Y,12)+(#order-rank+1)*0.8
				if score>bestScore then bestScore=score; best=p; bestPt=pt end
			end
		end
	end
	return best,bestPt
end
local function InCone(pos)
	local cam=Cam(); if not cam then return false,nil end
	local sp,on=cam:WorldToViewportPoint(pos)
	if not on or sp.Z<=0 then return false,nil end
	local ctr=cam.ViewportSize*0.5
	local d=(Vector2.new(sp.X,sp.Y)-ctr).Magnitude
	if d>C.FOV.R then return false,nil end
	local dir=pos-cam.CFrame.Position
	if dir.Magnitude<0.1 then return false,nil end
	local ang=math.deg(math.acos(math.clamp(cam.CFrame.LookVector:Dot(dir.Unit),-1,1)))
	if ang>C.FOV.Cone then return false,nil end
	return true,d
end
local function SolveAim(base,hrp,kind)
	local ch=hrp.Parent
	local d=vTrack[hrp]
	local vel=(d and d.vel) or Vector3.zero
	local acc=(d and d.acc) or Vector3.zero
	local hum=ch and ch:FindFirstChildOfClass("Humanoid")
	if hum and hum.MoveDirection.Magnitude<0.05 then vel=vel*0.08; acc=Vector3.zero end
	if vel.Magnitude>60 then vel=vel.Unit*60 end
	vel=Vector3.new(vel.X,vel.Y*0.3,vel.Z)
	if acc.Magnitude>200 then acc=acc.Unit*200 end
	acc=Vector3.new(acc.X,0,acc.Z)
	local rc=RealChar()
	local origin=(rc and rc:FindFirstChild("Head") and rc.Head.Position) or (Cam() and Cam().CFrame.Position) or base
	local t=0
	if C.Aim.Mode==3 then vel=Vector3.zero; acc=Vector3.zero
	elseif C.Aim.Mode==2 then t=0.12
	else
		if kind=="gun" then
			t=S.RTT*math.clamp(C.Aim.Net,0,1.5)
		else
			local spd=math.max(40,C.Knife.Speed)
			t=(base-origin).Magnitude/spd
			for _=1,4 do t=(base+vel*t-origin).Magnitude/spd end
		end
	end
	local lead=vel*t
	if C.Aim.Accel then lead=lead+acc*(t*t*0.5) end
	local maxLead=math.min(1.4,C.Aim.MaxLead)
	if lead.Magnitude>maxLead and lead.Magnitude>0.001 then lead=lead.Unit*maxLead end
	S.LastLead=lead.Magnitude
	local pos=base+lead
	if kind=="knife" then pos=pos+Vector3.new(0,0.5*GRAV*C.Knife.Grav*t*t,0) end
	return pos,t
end
local function TargetScore(p,pos,dist,ignoreFov)
	local ok,d
	if ignoreFov then ok,d=true,dist else ok,d=InCone(pos) end
	if not ok then return nil end
	if S.LastTarget==p and os.clock()-S.LastTargetT<1.5 then d=d*(1-math.clamp(C.Aim.Lock,0,0.8)) end
	return d
end
local function GetMurderer(ignoreFov)
	local cam=Cam(); if not cam then return nil end
	local rc=RealChar()
	local origin=(rc and rc:FindFirstChild("Head") and rc.Head.Position) or cam.CFrame.Position
	local best,bd=nil,math.huge
	for _,p in ipairs(Env.Players:GetPlayers()) do
		if p~=LP and p.Character and RoleOf(p)=="Murderer" then
			local ch=p.Character
			local hrp=ch:FindFirstChild("HumanoidRootPart")
			local hum=ch:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health>0 then
				local dist=(hrp.Position-origin).Magnitude
				if dist<=C.Aim.Dist then
					local part,pt=BestHitPart(ch,C.Aim.Wall or ignoreFov,C.Aim.Part)
					if part and pt then
						local pos=SolveAim(pt,hrp,"gun")
						local sc=TargetScore(p,pos,dist,ignoreFov or C.Aim.Wall)
						if sc and C.Aim.Vis and not C.Aim.Wall and not ignoreFov then
							if not PointVisible(pt,ch) then sc=nil end
						end
						if sc and sc<bd then bd=sc; best={P=p,Pos=pos,Char=ch,HRP=hrp,Part=part,Base=pt} end
					end
				end
			end
		end
	end
	if best then S.LastTarget=best.P; S.LastTargetT=os.clock(); S.LastAimPos=best.Pos; S.LastAimPart=best.Part end
	return best
end
local function GetKnifeTarget(ignoreFov)
	local cam=Cam(); if not cam then return nil end
	local best,bd=nil,math.huge
	for _,p in ipairs(Env.Players:GetPlayers()) do
		if p~=LP and p.Character and KnifeOK(p) then
			local ch=p.Character
			local hrp=ch:FindFirstChild("HumanoidRootPart")
			local hum=ch:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health>0 then
				local d0=(hrp.Position-cam.CFrame.Position).Magnitude
				if d0<=C.Knife.Dist then
					local part,pt=BestHitPart(ch,true,C.Knife.Part)
					if part and pt then
						local pos=SolveAim(pt,hrp,"knife")
						local sc=TargetScore(p,pos,d0,ignoreFov)
						if sc and sc<bd then bd=sc; best={P=p,Pos=pos,Char=ch,HRP=hrp,Part=part,Base=pt} end
					end
				end
			end
		end
	end
	if best then S.LastAimPos=best.Pos; S.LastAimPart=best.Part end
	return best
end

