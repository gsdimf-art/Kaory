local function Classify(self)
	for _,r in ipairs(S.GunRems) do if r==self then return "gun" end end
	for _,r in ipairs(S.KnifeRems) do if r==self then return "knife" end end
	local ok,nm=pcall(function()
		local p=self.Parent
		while p and p~=game do if p:IsA("Tool") then return p.Name end; p=p.Parent end
	end)
	if ok and nm then if nm=="Gun" then return "gun" elseif nm=="Knife" then return "knife" end end
	local n=string.lower(tostring(self))
	if n:find("shootgun") or n:find("createbeam") or n:find("shoot") then return "gun" end
	if n:find("throw") then return "knife" end
	return nil
end
local function Rewrite(kind,args,n)
	local rc=RealChar()
	local head=(rc and rc:FindFirstChild("Head") and rc.Head.Position) or (Cam() and Cam().CFrame.Position) or Vector3.zero
	local t,pos
	if kind=="gun" then
		if not C.Aim.Silent then return nil end
		t=GetMurderer(false); if not t then return nil end
		if math.random(1,100)>C.Aim.Chance then return nil end
		pos=t.Pos
		head=ApplyWallbang(head,pos,t.Char)
	else
		if not C.Knife.Silent then return nil end
		t=GetKnifeTarget(false); if not t then return nil end
		pos=t.Pos
	end
	local vi,ci={},{}
	for i=1,n do
		local ty=typeof(args[i])
		if ty=="Vector3" then vi[#vi+1]=i elseif ty=="CFrame" then ci[#ci+1]=i end
	end
	local ch=false
	if #vi>=2 then
		local minI,maxI,minD,maxD=vi[1],vi[#vi],math.huge,-1
		for _,i in ipairs(vi) do
			local d=(args[i]-head).Magnitude
			if d<minD then minD=d; minI=i end
			if d>maxD then maxD=d; maxI=i end
		end
		if minI~=maxI then args[minI]=head end
		args[maxI]=pos; ch=true
	elseif #vi==1 then args[vi[1]]=pos; ch=true end
	for _,i in ipairs(ci) do args[i]=CFrame.lookAt(head,pos); ch=true end
	if not ch then return nil end
	HOOK.Hits=HOOK.Hits+1; HOOK.Last=(kind=="gun") and "Gun" or "Knife"
	if C.FOV.Pulse then S.FOVP=1.32 end
	if ShotFX then task.spawn(ShotFX,head,pos,kind) end
	return args
end
local function FromExec()
	if typeof(checkcaller)=="function" then local ok,r=pcall(checkcaller); return ok and r==true end
	return false
end
local function InstallHook()
	if typeof(hookmetamethod)=="function" and typeof(getnamecallmethod)=="function" then
		local ok=pcall(function()
			local old
			old=hookmetamethod(game,"__namecall",function(self,...)
				if S.Busy then return old(self,...) end
				local mok,m=pcall(getnamecallmethod)
				if not mok then return old(self,...) end
				if m~="InvokeServer" and m~="FireServer" then return old(self,...) end
				if typeof(self)~="Instance" then return old(self,...) end
				if not (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then return old(self,...) end
				if FromExec() then return old(self,...) end
				local n=select("#",...); local args={...}
				S.Busy=true
				local ok2,kind=pcall(Classify,self)
				local res
				if ok2 and kind then
					local ok3,r3=pcall(Rewrite,kind,args,n)
					if ok3 then res=r3 end
				end
				S.Busy=false
				if res then return old(self,table.unpack(res,1,n)) end
				return old(self,...)
			end)
		end)
		if ok then HOOK.OK=true; HOOK.Mode="namecall"; return end
	end
	HOOK.OK=false; HOOK.Mode="unavailable"
end
InstallHook()
local function FireGun(t,allowEquip)
	local g,c,b=Tool("Gun")
	if not g or not c then return false end
	if g.Parent==b then if allowEquip then Equip(g,c,b) else return false end end
	local pos=t.Pos
	local hrp=c:FindFirstChild("HumanoidRootPart")
	local origin=(c:FindFirstChild("Head") and c.Head.Position) or (hrp and hrp.Position) or pos
	origin=ApplyWallbang(origin,pos,t.Char)
	if C.FOV.Pulse then S.FOVP=1.32 end
	local function Do(o)
		local sent=false
		S.Busy=true
		for _,rem in ipairs(GunRemotes(g)) do
			if rem:IsA("RemoteFunction") then
				if pcall(function() rem:InvokeServer(1,pos,"AH2") end) then sent=true break end
				if pcall(function() rem:InvokeServer(1,pos,"AH") end) then sent=true break end
			else
				if pcall(function() rem:FireServer(CFrame.new(o,pos),CFrame.new(pos)) end) then sent=true break end
			end
		end
		S.Busy=false
		if not sent then pcall(function() g:Activate() end) end
