		task.wait(0.5)
		pcall(ScanVoteGUI)
		if C.Vote.Auto and S.VoteSeen and not S.VoteAutoDone and #S.VoteData>0 then
			task.wait(math.clamp(C.Vote.Delay,0.3,5))
			local e=PickVote()
			if e and CastVote(e) then S.VoteAutoDone=true end
		end
	end
end)

