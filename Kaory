end
local function CoinPart(c)
	if c:IsA("BasePart") then return c end
	return c:FindFirstChildWhichIsA("BasePart",true) or c:FindFirstChildWhichIsA("MeshPart",true)
end
local function HasTouch(c) return c:FindFirstChildWhichIsA("TouchInterest",true)~=nil end
local function CoinGone(c,had)
	if not c.Parent then return true end
	if c:GetAttribute("Collected") then return true end
	if had and not HasTouch(c) then return true end
	return false
end
local function MurdererHRP()
	for _,p in ipairs(Env.Players:GetPlayers()) do
		if p~=LP and RoleOf(p)=="Murderer" then
			local c=p.Character
			local r=c and c:FindFirstChild("HumanoidRootPart")
			local h=c and c:FindFirstChildOfClass("Humanoid")
			if r and h and h.Health>0 then return r end
		end
	end
	return nil
end
local function NearestCoin(cc,my)
	local items=cc:GetChildren()
	local useTouch=false
	for _,c in ipairs(items) do if HasTouch(c) then useTouch=true break end end
	local mr=C.Avoid.On and MurdererHRP() or nil
	local best,bp,bd=nil,nil,math.huge
	for _,c in ipairs(items) do
		local part=CoinPart(c)
		if part and c.Parent and not c:GetAttribute("Collected") and (not useTouch or HasTouch(c)) then
			local sk=S.CoinSkip[c]
			if not sk or os.clock()>sk then
				local blocked=(mr and (mr.Position-part.Position).Magnitude<C.Avoid.Rad)
				if not blocked then
					local d=(part.Position-my.Position).Magnitude
					if d<bd then best,bp,bd=c,part,d end
				end
			end
		end
	end
	return best,bp
end
local function HoldOn()
	local c=RealChar(); local h=c and c:FindFirstChild("HumanoidRootPart"); if not h then return end
	h.Anchored=false
	if not h:FindFirstChild("KaoryHold") then
		local bv=Instance.new("BodyVelocity")
		bv.Name="KaoryHold"; bv.MaxForce=Vector3.new(1e9,1e9,1e9); bv.Velocity=Vector3.zero; bv.Parent=h
	end
end
local function HoldOff()
	local c=RealChar(); local h=c and c:FindFirstChild("HumanoidRootPart")
	if h then local bv=h:FindFirstChild("KaoryHold"); if bv then bv:Destroy() end; h.Anchored=false end
end
local function SafeSpot()
	if S.LobbyCF then return S.LobbyCF end
	local lobby=Env.Workspace:FindFirstChild("Lobby")
	local sp=lobby and lobby:FindFirstChild("Spawns")
	if sp then
		local kids=sp:GetChildren()
		if #kids>0 then
			local pick=kids[math.random(#kids)]
			if pick:IsA("BasePart") then return pick.CFrame+Vector3.new(0,4,0) end
		end
	end
	local any=Env.Workspace:FindFirstChildWhichIsA("SpawnLocation",true)
	if any then return any.CFrame+Vector3.new(0,4,0) end
	local c=RealChar(); local h=c and c:FindFirstChild("HumanoidRootPart")
	return h and h.CFrame
end
local function AbortIfMurderer()
	if not (C.Avoid.On and C.Avoid.Abort) then return false end
	local mr=MurdererHRP()
	local c=RealChar(); local my=c and c:FindFirstChild("HumanoidRootPart")
	if mr and my and (mr.Position-my.Position).Magnitude<C.Avoid.Rad then
		S.FarmState=5
		if C.Avoid.Hide then
			HoldOn(); my.CFrame=SafeSpot(); my.AssemblyLinearVelocity=Vector3.zero
			task.wait(0.2); HoldOff()
		end
		return true
	end
	return false
end
local function Collect(coin,part,had)
	local t0=os.clock()
	while os.clock()-t0<0.7 do
		local c=RealChar(); local h=c and c:FindFirstChild("HumanoidRootPart")
		if not h then return false end
		h.AssemblyLinearVelocity=Vector3.zero
		if typeof(firetouchinterest)=="function" then
			local ti=coin:FindFirstChildWhichIsA("TouchInterest",true)
			local tp=(ti and ti.Parent and ti.Parent:IsA("BasePart")) and ti.Parent or part
			for _,limb in ipairs(c:GetChildren()) do
				if limb:IsA("BasePart") then pcall(function() firetouchinterest(limb,tp,0); firetouchinterest(limb,tp,1) end) end
			end
		end
		if CoinGone(coin,had) then return true end
		if AbortIfMurderer() then return false end
		task.wait(0.06)
	end
	return false
end
local function FarmStep()
	if S.FarmBusy or S.Flinging then return end
	S.FarmBusy=true
	pcall(function()
		local cc=FindCC()
		if not cc or #cc:GetChildren()==0 then S.FarmState=4; return end
		if C.Farm.Limit>0 and S.FarmCount>=C.Farm.Limit then
			if C.Farm.AutoReset then S.FarmCount=0 else S.FarmState=3; return end
		end
		local c=RealChar()
		local my=c and c:FindFirstChild("HumanoidRootPart")
		local hum=c and c:FindFirstChildOfClass("Humanoid")
		if not my or not hum then return end
		if not S.LobbyCF then S.LobbyCF=my.CFrame end
		if AbortIfMurderer() then return end
		local coin,part=NearestCoin(cc,my)
		if not coin then S.FarmState=4; return end
		local had=HasTouch(coin)
		local target=part.Position+Vector3.new(0,C.Farm.Height,0)
		S.FarmState=3
		local arrived=false
		if C.Farm.Mode==1 then
			HoldOn()
			local origin=my.CFrame
			my.CFrame=CFrame.new(target)*my.CFrame.Rotation
			my.AssemblyLinearVelocity=Vector3.zero
			local got=Collect(coin,part,had)
			if C.Farm.Return and my.Parent then my.CFrame=origin; my.AssemblyLinearVelocity=Vector3.zero end
			HoldOff()
			if got then S.FarmCount=S.FarmCount+1 else S.CoinSkip[coin]=os.clock()+8 end
			return
		elseif C.Farm.Mode==2 then
			HoldOn()
			local spd=math.clamp(C.Farm.Speed,20,400)
			local limit=(target-my.Position).Magnitude/spd+4
			local t0=os.clock()
			while C.Farm.On and coin.Parent and os.clock()-t0<limit do
				local cc2=RealChar(); local h=cc2 and cc2:FindFirstChild("HumanoidRootPart")
				if not h then break end
				local dt=Env.Run.Heartbeat:Wait()
				if dt<=0 or dt>0.1 then dt=1/60 end
				if AbortIfMurderer() then HoldOff(); return end
				local diff=target-h.Position
				local dist=diff.Magnitude
				if dist<1.2 then
					h.CFrame=CFrame.new(target)*h.CFrame.Rotation
					h.AssemblyLinearVelocity=Vector3.zero; arrived=true; break
				end
				local step=spd*dt
				if step>=dist then h.CFrame=CFrame.new(target)*h.CFrame.Rotation
				else h.CFrame=CFrame.new(h.Position+diff.Unit*step)*h.CFrame.Rotation end
				h.AssemblyLinearVelocity=Vector3.zero
				h.AssemblyAngularVelocity=Vector3.zero
			end
			HoldOff()
		else
			local spd=math.clamp(C.Farm.Speed,16,150)
			hum.WalkSpeed=spd
			local limit=(target-my.Position).Magnitude/spd+6
			local t0=os.clock()
			while C.Farm.On and coin.Parent and os.clock()-t0<limit do
				local cc2=RealChar()
				local h=cc2 and cc2:FindFirstChild("HumanoidRootPart")
				local hm=cc2 and cc2:FindFirstChildOfClass("Humanoid")
				if not h or not hm then break end
				if AbortIfMurderer() then return end
				hm.WalkSpeed=spd; hm:MoveTo(part.Position)
				if (h.Position-part.Position).Magnitude<4 then arrived=true break end
				task.wait(0.12)
			end
		end
		if arrived then
			local got=Collect(coin,part,had)
			if got then S.FarmCount=S.FarmCount+1 else S.CoinSkip[coin]=os.clock()+8 end
		else S.CoinSkip[coin]=os.clock()+8 end
	end)
	S.FarmBusy=false
end
task.spawn(function()
	while true do
		task.wait(math.clamp(C.Farm.Delay,0.18,3))
		if C.Farm.On then FarmStep() else S.FarmState=1 end
	end
end)

