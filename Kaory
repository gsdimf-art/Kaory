local function FindVoteRemote()
	if S.VoteRemote and S.VoteRemote.Parent then return S.VoteRemote end
	for _,d in ipairs(Env.RS:GetDescendants()) do
		if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
			local n=string.lower(d.Name)
			local pn=d.Parent and string.lower(d.Parent.Name) or ""
			if n:find("vote") or pn:find("vote") then S.VoteRemote=d; return d end
		end
	end
	return nil
end
local function ScanVoteGUI()
	local pg=LP:FindFirstChild("PlayerGui"); if not pg then return end
	local found={}
	for _,d in ipairs(pg:GetDescendants()) do
		if d:IsA("GuiObject") and d.Visible then
			local n=string.lower(d.Name)
			if (n:find("vote") or n:find("mapvote")) and (d:IsA("Frame") or d:IsA("ScrollingFrame")) then
				local entries={}
				for _,k in ipairs(d:GetChildren()) do
					if k:IsA("GuiObject") and k.Visible then
						local name,votes,img=nil,0,nil
						local il=k:FindFirstChildWhichIsA("ImageLabel",true) or k:FindFirstChildWhichIsA("ImageButton",true)
						if il then img=il.Image end
						for _,t in ipairs(k:GetDescendants()) do
							if t:IsA("TextLabel") or t:IsA("TextButton") then
								local tx=tostring(t.Text or "")
								if tx~="" then
									if tx:match("^%d+$") then votes=tonumber(tx) or 0
									elseif #tx>2 and not name and not tx:lower():find("vote") then name=tx end
								end
							end
						end
						if not name then name=k.Name end
						if name and #entries<3 then entries[#entries+1]={Name=name,Votes=votes,Image=img,Btn=k} end
					end
				end
				if #entries>=2 then found=entries break end
			end
		end
	end
	if #found>=2 then
		local changed=(#S.VoteData~=#found)
		if not changed then
			for i,e in ipairs(found) do if S.VoteData[i] and S.VoteData[i].Name~=e.Name then changed=true break end end
		end
		S.VoteData=found
		if changed then S.VoteSeen=true; S.VoteAutoDone=false end
	else
		if #S.VoteData>0 then S.VoteSeen=false; S.VoteAutoDone=false end
		S.VoteData={}
	end
end
local function CastVote(e)
	if not e then return false end
	local rem=FindVoteRemote()
	if rem then
		local prev=S.Busy; S.Busy=true
		local ok=pcall(function()
			if rem:IsA("RemoteEvent") then rem:FireServer(e.Name) else rem:InvokeServer(e.Name) end
		end)
		S.Busy=prev
		if ok then return true end
	end
	local b=e.Btn
	if b and b.Parent then
		local btn=b:IsA("GuiButton") and b or b:FindFirstChildWhichIsA("GuiButton",true)
		if btn then
			if typeof(firesignal)=="function" then
				local ok=false
				pcall(function() firesignal(btn.MouseButton1Click); ok=true end)
				pcall(function() firesignal(btn.Activated); ok=true end)
				if ok then return true end
			end
			if typeof(getconnections)=="function" then
				local done=false
				pcall(function()
					for _,cn in ipairs(getconnections(btn.MouseButton1Click)) do cn:Fire(); done=true end
					for _,cn in ipairs(getconnections(btn.Activated)) do cn:Fire(); done=true end
				end)
				if done then return true end
			end
		end
	end
	return false
end
local function PickVote()
	if #S.VoteData==0 then return nil end
	local m=C.Vote.Pick
	if m==1 then
		local best=S.VoteData[1]
		for _,e in ipairs(S.VoteData) do if e.Votes>best.Votes then best=e end end
		return best
	elseif m==2 then
		local best=S.VoteData[1]
		for _,e in ipairs(S.VoteData) do if e.Votes<best.Votes then best=e end end
		return best
	elseif m==3 then return S.VoteData[math.random(1,#S.VoteData)]
	else return S.VoteData[1] end
end
task.spawn(function()
