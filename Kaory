local function StripWalls(a,b,tc)
	local rp=RaycastParams.new(); rp.FilterType=Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances=IgnoreList
	for _=1,18 do
		local hit=SafeRay(a,b-a,rp)
		if not hit then break end
		if tc and hit.Instance:IsDescendantOf(tc) then break end
		if hit.Instance and hit.Instance:IsA("BasePart") then
			if S.Strip[hit.Instance]==nil then S.Strip[hit.Instance]=hit.Instance.CanQuery end
			pcall(function() hit.Instance.CanQuery=false end)
			local nf={}
			for _,v in ipairs(rp.FilterDescendantsInstances) do nf[#nf+1]=v end
			nf[#nf+1]=hit.Instance; rp.FilterDescendantsInstances=nf
		else break end
	end
	S.LastStrip=os.clock()
end
local function RestoreWalls()
	for p,o in pairs(S.Strip) do if p and p.Parent then pcall(function() p.CanQuery=o end) end end
	table.clear(S.Strip)
end
local function ShiftOrigin(o,t)
	local d=t-o; if d.Magnitude<3 then return o end
	return t-d.Unit*2.0
end
local function BlinkExec(tc,fn)
	if S.Blinking then return fn() end
	local rc=RealChar(); local hrp=rc and rc:FindFirstChild("HumanoidRootPart")
	local th=tc and tc:FindFirstChild("HumanoidRootPart")
	if not hrp or not th then return fn() end
	S.Blinking=true
	local saved=hrp.CFrame
	local behind=th.CFrame*CFrame.new(0,0.5,3.0)
	hrp.CFrame=behind; hrp.AssemblyLinearVelocity=Vector3.zero
	local res=fn(behind.Position)
	task.defer(function()
		if hrp and hrp.Parent then hrp.CFrame=saved; hrp.AssemblyLinearVelocity=Vector3.zero end
		S.Blinking=false
	end)
	return res
end
local function ApplyWallbang(origin,pos,tchar)
	if not C.Aim.Wall then return origin end
	local m=C.Aim.WB
	if m==1 or m==4 then StripWalls(origin,pos,tchar) end
	if m==2 or m==4 then origin=ShiftOrigin(origin,pos) end
	return origin
end

