local ROLESET={Murderer=true,Sheriff=true,Hero=true,Innocent=true}
local function ParseRoles(d)
	if type(d)~="table" then return end
	for k,v in pairs(d) do
		local nm,rl=nil,nil
		if type(k)=="string" then nm=k end
		if type(v)=="string" and ROLESET[v] then rl=v
		elseif type(v)=="table" then
			if type(v.Role)=="string" and ROLESET[v.Role] then rl=v.Role end
			if type(v.Name)=="string" then nm=v.Name end
		end
		if nm and rl then S.Net[nm]=rl end
	end
end
local function RoleOf(p)
	if not p then return "Unknown" end
