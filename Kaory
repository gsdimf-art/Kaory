				local ty=math.clamp(-vel.Y*0.035,-C.TiltPow,C.TiltPow)
				S.Win.LX=S.Win.LX+(tx-S.Win.LX)*sw
				S.Win.LY=S.Win.LY+(ty-S.Win.LY)*sw
