Env.Run.Heartbeat:Connect(function()
	pcall(function()
		if not UI.Screen.Parent then return end
		local now=os.clock(); local dt=math.clamp(now-S.PHb,0.001,0.05); S.PHb=now
		local rc=RealChar(); if rc then S.Real=rc end
		local hrp=rc and rc:FindFirstChild("HumanoidRootPart")
		local ac=(S.Clone and S.Clone.Parent) and S.Clone or rc
		local ahrp=ac and ac:FindFirstChild("HumanoidRootPart")
		local ahum=ac and ac:FindFirstChildOfClass("Humanoid")
		local cam=Cam()
		if cam then
			if cam.CameraType~=Enum.CameraType.Custom and not S.Flinging then
				pcall(function() cam.CameraType=Enum.CameraType.Custom end)
			end
			local subj=cam.CameraSubject
			if subj==nil or subj.Parent==nil then
				if ahum then pcall(function() cam.CameraSubject=ahum end) end
			end
			if ahrp and ahrp.Anchored and not S.Flinging then pcall(function() ahrp.Anchored=false end) end
		end
		if C.Invis.On and hrp then
			if not S.Clone or not S.Clone.Parent then Inv.Start() end
			S.DesAcc=S.DesAcc+dt
			if S.DesAcc>=1/math.clamp(C.Invis.Rate,1,60) then
				S.DesAcc=0
				local ch=S.Clone and S.Clone:FindFirstChild("HumanoidRootPart")
				local base=(ch and ch.CFrame) or S.Origin or hrp.CFrame
				if C.Invis.Mode==1 then
					local r=C.Invis.Range
					local rx,ry,rz=(math.random()*2-1)*r,r*0.75+math.random()*(r*0.25),(math.random()*2-1)*r
					local rot=C.Invis.Pitch and CFrame.Angles(math.rad(math.random(-180,180)),math.rad(math.random(-180,180)),math.rad(math.random(-180,180))) or CFrame.identity
					hrp.CFrame=CFrame.new(base.Position+Vector3.new(rx,ry,rz))*rot
					hrp.AssemblyLinearVelocity=Vector3.new(rx*5,9999,rz*5)
				else
					local off=base.RightVector*C.Invis.X+Vector3.new(0,C.Invis.Y,0)+base.LookVector*(-C.Invis.Z)
					hrp.AssemblyLinearVelocity=Vector3.zero; hrp.CFrame=base+off
				end
			end
		end
		if ahum and ahrp and not C.Farm.On then
			if C.Move.SpeedOn then ahum.WalkSpeed=C.Move.Speed end
			if C.Move.Spin then
				ahum.AutoRotate=false
				S.SpinA=(S.SpinA+C.Move.SpinSpd*dt*10)%360
				ahrp.CFrame=CFrame.new(ahrp.Position)*CFrame.Angles(0,math.rad(S.SpinA),0)
			else ahum.AutoRotate=true end
			if C.Bhop.On then
				local h=C.Bhop.Height
				local v0=math.sqrt(2*GRAV*h)
				pcall(function() ahum.UseJumpPower=true; ahum.JumpPower=v0 end)
				local md=ahum.MoveDirection
				local grounded=(ahum.FloorMaterial~=Enum.Material.Air)
				if md.Magnitude>0.05 then
					if grounded then
						S.BhopAir=false
						if C.Bhop.Auto and now-S.BhopJumpT>0.12 then
							ahum.Jump=true; S.BhopJumpT=now; S.BhopAir=true
						end
						if C.Bhop.Mode==1 then S.BhopAcc=math.max(16,S.BhopAcc-4) else S.BhopAcc=16 end
					else
						S.BhopAir=true
						local airTime=2*v0/GRAV
						local want=math.clamp(C.Bhop.Dist/math.max(airTime,0.1),16,C.Bhop.Max)
						if C.Bhop.Mode==1 then S.BhopAcc=math.min(S.BhopAcc+2.2,want)
						elseif C.Bhop.Mode==2 then S.BhopAcc=want
						else S.BhopAcc=math.min(want,ahum.WalkSpeed*1.25) end
						if (not C.Bhop.AirOnly) or S.BhopAir then
							ahrp.AssemblyLinearVelocity=Vector3.new(md.X*S.BhopAcc,ahrp.AssemblyLinearVelocity.Y,md.Z*S.BhopAcc)
						end
					end
				else S.BhopAir=false; S.BhopAcc=16 end
			else S.BhopAir=false end
		end
		local g0=Tool("Gun"); if g0 then GunRemotes(g0) end
		local k0=Tool("Knife"); if k0 then KnifeRemotes(k0) end
		if C.Aim.Auto and now-S.LastShot>=C.Aim.Rate then
			local g,ch,bp=Tool("Gun")
			if g and ch and (g.Parent==ch or (C.Aim.Equip and g.Parent==bp)) then
				local t=GetMurderer(false)
				if t and FireGun(t,C.Aim.Equip) then S.LastShot=now end
			end
		end
		if C.Knife.Auto and now-S.LastThrow>=C.Knife.Rate then
			local k,ch,bp=Tool("Knife")
			if k and ch and hrp and (k.Parent==ch or (C.Knife.Equip and k.Parent==bp)) then
				local t=GetKnifeTarget(false)
				if t and (t.HRP.Position-hrp.Position).Magnitude>8 then
					if ThrowKnife(t,C.Knife.Equip) then S.LastThrow=now end
				end
			end
		end
		if C.Kill.On and now-S.LastKill>C.Kill.Rate and hrp then
			S.LastKill=now
			for _,p in ipairs(Env.Players:GetPlayers()) do
				if p~=LP and p.Character and KnifeOK(p) then
					local th=p.Character:FindFirstChild("HumanoidRootPart")
					local hum=p.Character:FindFirstChildOfClass("Humanoid")
					if th and hum and hum.Health>0 and (th.Position-hrp.Position).Magnitude<=C.Kill.Reach then KillTouch(p.Character) end
				end
			end
		end
		if next(S.Strip)~=nil and now-S.LastStrip>0.3 then RestoreWalls() end
		if C.Grab.On and S.GunDrop and S.GunDrop.Parent and not S.GrabDone and S.GrabTries<15 then
			GrabNow(S.GunDrop)
		end
		if C.Prot.AntiFling then
			for _,p in ipairs(Env.Players:GetPlayers()) do
				if p~=LP and p.Character and (not S.Flinging or p~=S.FlingTarget) then
					for _,part in ipairs(p.Character:GetDescendants()) do
						if part:IsA("BasePart") and part.CanCollide then part.CanCollide=false end
					end
				end
			end
		end
		if C.Prot.Noclip and rc and not S.Flinging and not C.Farm.On then
			for _,d in ipairs(rc:GetDescendants()) do if d:IsA("BasePart") and d.CanCollide then d.CanCollide=false end end
		end
		S.Slow=S.Slow+dt
		if S.Slow>=0.2 then
			S.Slow=0
			for _,p in ipairs(Env.Players:GetPlayers()) do
				local h=p.Character and p.Character:FindFirstChildOfClass("Humanoid")
				if h and h.Health>0 then
					local r=RoleOf(p)
					if r~="Unknown" and r~="Innocent" then S.Alive[p]=r end
				end
				S.Roles[p]=RoleOf(p)
			end
			if C.GunESP and S.GunDrop and S.GunDrop.Parent then
				if not S.GunHL or S.GunHL.Parent~=S.GunDrop then
					if S.GunHL then S.GunHL:Destroy() end
					S.GunHL=Instance.new("Highlight",S.GunDrop); S.GunHL.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
				end
				S.GunHL.FillColor=C.GunCol; S.GunHL.OutlineColor=C.GunCol; S.GunHL.FillTransparency=0.45
			elseif S.GunHL then S.GunHL:Destroy(); S.GunHL=nil end
		end
	end)
end)

Env.Run.RenderStepped:Connect(function()
