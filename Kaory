	if cs and cs.Parent then S.CC=cs.Parent; return cs.Parent end
	for _,d in ipairs(Env.Workspace:GetDescendants()) do
		if d:IsA("Folder") or d:IsA("Model") then
			local ln=d.Name:lower()
			if (ln:find("candy") or ln:find("coin")) and #d:GetChildren()>0 then S.CC=d; return d end
		end
	end
